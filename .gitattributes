# 改行コードを LF に統一する (Unity の .meta / アセットは YAML なので LF 固定)
* text=auto eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.meta text eol=lf
*.unity text eol=lf merge=unityyamlmerge
*.prefab text eol=lf merge=unityyamlmerge
*.asset text eol=lf merge=unityyamlmerge

# バイナリ
*.png binary
*.jpg binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
